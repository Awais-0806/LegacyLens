# Shared
APP_ENV=development
APP_NAME=LegacyLens
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# Backend security
CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Database
DATABASE_URL=postgresql+psycopg://legacylens:change-me@localhost:5432/legacylens
SQLITE_DATABASE_URL=sqlite:///./legacylens.db

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
MAX_REPOSITORY_SIZE_MB=100
MAX_FILE_SIZE_MB=10
MAX_FILE_COUNT=10000
MAX_EXTRACTION_FILES=10000
INGESTION_TIMEOUT_SECONDS=30
MAX_TOTAL_EXTRACTED_SIZE_MB=250
MAX_PATH_LENGTH=512
